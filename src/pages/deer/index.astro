---
/* Roadkill counter. No r4 preview exists for this page, so it is built from the
   r4 vocabulary: .page-head + pen scene, .sec car heads, mono meta lines, and
   Prose for each incident's markdown. Grouping (by car, cars ordered by their most
   recent incident, incidents newest first) matches the pre-redesign page. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import { deerCounts, isoDate, fmtDate } from '../../lib/site';

const totals = await deerCounts();

const deerEntries: CollectionEntry<'deer'>[] = await getCollection('deer');
const incidents = await Promise.all(
  deerEntries
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id))
    .map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);

/* insertion order = newest first, so the first entry per car is that car's latest */
const byCar = new Map<string, typeof incidents>();
for (const i of incidents) {
  const list = byCar.get(i.entry.data.car);
  if (list) list.push(i);
  else byCar.set(i.entry.data.car, [i]);
}
const cars = [...byCar.entries()].sort(
  (a, b) => b[1][0].entry.data.date.getTime() - a[1][0].entry.data.date.getTime()
);

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---
<Base
  title="Roadkill Counter"
  description="A running tally of animal-related automotive incidents."
  scene="deer"
>
  <header class="page-head">
    <div class="page-head__text">
      <h1>Murphy's Law Counter</h1>
      <p class="page-sub">{totals.deer} deer &middot; {totals.raccoon} raccoons &middot; {totals.cars} cars</p>
      <p class="stats">A running tally of my encounters with Michigan's wildlife.</p>
    </div>
    <canvas class="pen" data-scene="deer" aria-hidden="true"></canvas>
  </header>
  {cars.map(([car, list]) => (
    <section class="car">
      <h2 class="sec">{car} &middot; {plural(list.length, 'incident')}</h2>
      {list.map(({ entry, Content }) => (
        <article class="inc">
          <p class="inc__meta">
            <time datetime={isoDate(entry.data.date)}>{fmtDate(entry.data.date)}</time>
            &middot; {entry.data.animal}{entry.data.count > 1 && ` ×${entry.data.count}`}
            {entry.data.damage && <> &middot; {entry.data.damage}</>}
          </p>
          <h3 class="inc__title">{entry.data.title}</h3>
          <Prose><Content /></Prose>
          {entry.data.images.length > 0 && (
            <div class="inc__shots">{entry.data.images.map((src: string) => (
              <img src={src} alt={`${entry.data.title} — damage photo`} width="280" height="210" loading="lazy" decoding="async" />
            ))}</div>
          )}
        </article>
      ))}
    </section>
  ))}
</Base>
<style>
  /* the deer page tints its sub-line with the accent; the rest of .page-sub is global. */
  .page-sub { color: var(--accent-text); }
  /* r4/style.css 179 */
  .page-head + .car .sec { margin-top: 0; }

  .inc { max-width: var(--w-prose); padding: 0 0 28px; }
  .inc + .inc { border-top: 1px solid var(--line); padding-top: 20px; }
  .inc__meta { margin: 0 0 4px; font: 12.5px/1.6 var(--mono); color: var(--accent-2); }
  .inc__title { margin: 0 0 8px; font-size: 18px; }
  .inc__shots { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  /* fixed thumbnail box: explicit dimensions, so lazy loading costs no layout shift */
  .inc__shots img { width: 280px; height: 210px; object-fit: contain; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); }
  @media (max-width: 560px) { .inc__shots img { width: 100%; height: auto; } }
</style>
