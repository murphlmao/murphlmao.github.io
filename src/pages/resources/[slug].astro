---
/* Snippet detail page, now served under /resources/<id>. Same head/prose shape
   as the article page (docs/redesign-previews/r4/article.html); interactive
   snippets keep the wide column so the WASM demo fits, markdown snippets read
   at prose width. */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import OptimizationTriangle from '../../components/wasm/OptimizationTriangle.astro';
import { fmtDate, isoDate, parseHumanDate } from '../../lib/site';

export async function getStaticPaths() {
  const snippets: CollectionEntry<'snippets'>[] = await getCollection('snippets');
  return snippets.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'snippets'> };
const { entry } = Astro.props;
const { Content } = await render(entry);
const interactive = entry.data.type === 'interactive';
const date = parseHumanDate(entry.data.date); // human string in frontmatter, parsed to UTC midnight
---
<Base title={entry.data.title} description={entry.data.description} scene="snippets" article={!interactive}>
  <article>
    <header class="page-head">
      <div class="page-head__text">
        <a class="crumb" href="/resources">&larr; All resources</a>
        <h1>{entry.data.title}</h1>
        {date && <p class="page-sub"><time datetime={isoDate(date)}>{fmtDate(date)}</time></p>}
      </div>
      <canvas class="pen" data-scene="snippets" aria-hidden="true"></canvas>
    </header>
    {interactive && <OptimizationTriangle assetPath={entry.data.assetPath} />}
    <div class="snippet-body"><Prose><Content /></Prose></div>
  </article>
</Base>
<style>
  .snippet-body { max-width: var(--w-prose); min-width: 0; margin-top: 28px; }
</style>
