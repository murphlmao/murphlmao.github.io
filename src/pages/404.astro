---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="Page not found." scene="none">
  <h1>404</h1>
  <p class="lost">Nothing here. The cat checked.</p>
  <a class="back" href="/">&larr; Home</a>
</Base>
<style>
  .lost { margin: 12px 0 20px; color: var(--muted); font-size: 15.5px; }
  .back { font: 13px var(--mono); color: var(--accent-text); text-decoration: none; }
  .back:hover { text-decoration: underline; }
</style>
