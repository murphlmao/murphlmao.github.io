---
/* Home. Markup ported from docs/redesign-previews/r4/index.html as amended by
   spec-v2.md §1 (page-head, then .home = .home__main + aside.rail). CSS from
   r4/style.css (.kicker, .hero-title, .hl, .sec, .more, .bio*) and r4/pages.css
   section 1 (.home, .home__main, .rail*). The rail is data-driven: work from
   src/content/resume.ts, courses from the blog structure, writing from getStats(). */
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts, getStats, courseCounts, byCourseNumberDesc } from '../lib/site';
import { getBlogStructure } from '../lib/content';
import { experience, type Entry } from '../content/resume';

const posts = (await getPosts()).slice(0, 5);
const stats = await getStats();
const counts = await courseCounts();
const categories = byCourseNumberDesc(getBlogStructure().flatMap((h) => h.categories));

/* rail work: the two jobs held most recently — "Current" sorts first. Same pair r4
   shows at index.html:70-71 (Prism Controls, the consulting entry). */
const endsAt = (e: Entry) => (e.end === 'Current' ? Infinity : Date.parse(e.end));
const jobs = [...experience].sort((a, b) => endsAt(b) - endsAt(a)).slice(0, 2);
---
<Base scene="home" wide>
  <header class="page-head">
    <div class="page-head__text">
      <p class="kicker">Prism Controls &middot; University of Michigan</p>
      <h1 class="hero-title">Murphy <span class="hl">Malcolm</span></h1>
    </div>
    <canvas class="pen" data-scene="home" aria-hidden="true"></canvas>
  </header>
  <div class="home">
    <div class="home__main">
      <section class="bio">
        {/* photo parked for now; restore this and the 120px column in .bio to bring it back
        <figure class="bio__photo">
          <img src="/profile.jpeg" alt="Murphy asleep with a cat" width="300" height="277" />
        </figure>
        */}
        <div class="bio__text">
          <p>I'm a software, systems, & platform engineer at Prism Controls. I'm also currently studying Computer Science & Sociology at the University of Michigan.</p>
          <p>I specialize in full-stack development, DevSecOps, and embedded systems. I've a deep passion for all of the above, but also Linux (Arch btw), networking, cybersecurity, and cats!</p>
          <p>I'm opinionated about technology&mdash;but those opinions come from a genuine love of the game and a drive to continuously learn and improve. Always happy to connect and talk.</p>
        </div>
      </section>
      <h2 class="sec">latest</h2>
      <ol class="post-list">{posts.map((p) => <PostRow post={p} chip />)}</ol>
      <p class="more"><a href="/articles">all {stats.total} articles &rarr;</a></p>
    </div>
    <aside class="rail" aria-label="At a glance">
      <section class="rail__block">
        <h2 class="rail__label">work</h2>
        {jobs.map((job) => (
          <p class="rail__job">
            <span class="rail__co">{job.org}</span>
            <span class="rail__role">{job.title}</span>
            <span class="rail__dates">{job.start} &mdash; {job.end}</span>
          </p>
        ))}
        <p class="more"><a href="/resume">resume &rarr;</a></p>
      </section>
      <section class="rail__block">
        <h2 class="rail__label">courses</h2>
        <ul class="rail__list">
          {categories.map((c) => (
            <li><a href={`/articles/${c.slug}`}>{c.name}</a><span class="rail__count">{counts[c.slug] || 0}</span></li>
          ))}
        </ul>
      </section>
      <section class="rail__block">
        <h2 class="rail__label">writing</h2>
        <p class="rail__stat"><strong class="rail__num">{stats.total}</strong>articles</p>
        <p class="rail__stat"><strong class="rail__num">{stats.words.toLocaleString('en-US')}</strong>words</p>
        <p class="rail__stat">since<strong class="rail__num">{stats.since}</strong></p>
      </section>
    </aside>
  </div>
</Base>
<style>
  /* r4/style.css 167-169 + the swipe keyframes */
  .kicker { margin: 0 0 14px; font: 500 12px/1.5 var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent-text); }
  .hero-title { font-size: 44px; letter-spacing: -.02em; margin: 0 0 6px; }
  .hl { padding: 0 .1em; background: linear-gradient(var(--hl), var(--hl)) no-repeat 0 78% / 0% .5em; animation: swipe .6s ease-out .4s forwards; }
  @keyframes swipe { to { background-size: 100% .5em; } }
  /* r4/style.css 385. styles/base.css carries the same override, but this scoped rule
     outranks it, so the swiped-in state has to be restated here. */
  @media (prefers-reduced-motion: reduce) { .hl { background-size: 100% .5em; } }

  /* r4/style.css 179-182 */
  .page-head + .sec { margin-top: 0; }
  .more { margin: 14px 0 0; font: 13px var(--mono); }
  .more a { color: var(--muted); text-decoration: none; }
  .more a:hover { color: var(--accent-text); }

  /* r4/style.css 187-192 */
  /* photo column parked with the figure above: was `120px 1fr` */
  .bio { display: grid; grid-template-columns: 1fr; gap: 24px; align-items: start; margin: 0 0 8px; }
  .bio__photo { margin: 0; }
  .bio__photo img { width: 120px; border: 1px solid var(--line); border-radius: var(--radius); }
  .bio__text { max-width: 62ch; }
  .bio__text p { margin: 0 0 1.1em; }
  /* r4/style.css 184-185, the .bio share of the shared link rule */
  .bio a { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: .18em; }
  .bio a:hover { color: var(--accent-text); }

  /* r4's home rows showed the course as a .post-tags chip under the description; ours use
     PostRow's `chip` (.post-course), so the row needs a third, content-sized column for it.
     It folds onto its own line at the widths where PostRow already moves .post-course. */
  .home__main .post-list :global(.post-row) { grid-template-columns: auto 10ch minmax(0, 1fr); }

  /* r4/pages.css section 1 — main column + quiet right rail */
  .home { display: block; }
  .home__main { min-width: 0; }
  .rail { min-width: 0; color: var(--muted); }
  .rail__block { min-width: 0; }
  .rail__label { margin: 0 0 10px; font: 500 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }

  /* work block: company / role / dates, then "resume →" (reuses .more) */
  .rail__job { margin: 0 0 12px; }
  .rail__co { display: block; font-size: 14.5px; font-weight: 500; line-height: 1.4; color: var(--text); }
  .rail__role { display: block; font-size: 13px; line-height: 1.4; color: var(--muted); }
  .rail__dates { display: block; margin-top: 1px; font: 12px/1.5 var(--mono); color: var(--muted); white-space: nowrap; }
  .rail .more { margin-top: 4px; }

  /* courses block: code left, count right */
  .rail__list { list-style: none; margin: 0; padding: 0; }
  .rail__list li { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 3px 0; font: 13px/1.5 var(--mono); }
  .rail__list a { color: var(--text); text-decoration: none; }
  .rail__list a:hover { color: var(--accent-text); }
  .rail__count { color: var(--accent-text); font-variant-numeric: tabular-nums; }

  /* writing block: big number, small label */
  .rail__stat { display: flex; align-items: baseline; gap: 8px; margin: 0 0 4px; font: 12.5px/1.5 var(--mono); color: var(--muted); }
  .rail__num { font: 500 20px/1.2 var(--sans); letter-spacing: -.01em; color: var(--text); font-variant-numeric: tabular-nums; }

  /* folded (< 1280px): the three blocks sit in one row under the latest list */
  .rail { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 32px; margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--line); }

  @media (min-width: 1280px) {
    .home { display: grid; grid-template-columns: minmax(0, 1fr) var(--w-rail); gap: 0 48px; align-items: start; }
    .rail { display: block; margin-top: 0; padding-top: 0; border-top: 0; }
    .rail__block + .rail__block { margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--line); }
  }
  @media (max-width: 899px) {
    /* r4/style.css 357 */
    .hero-title { font-size: 34px; }
    .home__main .post-list :global(.post-row) { grid-template-columns: 10ch minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    /* r4/style.css 364-365, r4/pages.css */
    .bio { gap: 14px; }  /* was `96px 1fr` with the photo */
    .bio__photo img { width: 96px; }
    .rail { grid-template-columns: 1fr; gap: 20px; }
    .home__main .post-list :global(.post-row) { grid-template-columns: 1fr; }
  }
</style>
