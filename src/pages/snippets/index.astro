---
/* Snippets index. Markup and CSS ported from docs/redesign-previews/r4/snippets.html
   and r4/style.css (.post-list, .post-row, .post-date, .post-title, .post-desc,
   .post-tags, .tag). Rows are rendered here rather than through PostRow.astro,
   which is typed to the blog collection. */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { isoDate, parseHumanDate } from '../../lib/site';

/* frontmatter dates are human strings ("December 1, 2025"), so parse them to UTC
   midnight — otherwise isoDate reads the UTC day off a local-midnight instant and
   a build host east of UTC renders the previous day. */
const snippets = (await getCollection('snippets'))
  .map((entry) => ({ entry, date: parseHumanDate(entry.data.date) }))
  .sort((a, b) => (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0));
---
<Base
  title="Snippets"
  description="A collection of code snippets that may or may not have some utility... somewhere."
  scene="snippets"
>
  <header class="page-head">
    <div class="page-head__text">
      <h1>Code snippets for developers</h1>
      <p class="page-sub">A collection of code snippets that may or may not have some utility... somewhere.</p>
    </div>
    <canvas class="pen" data-scene="snippets" aria-hidden="true"></canvas>
  </header>
  <ol class="post-list">{snippets.map(({ entry, date }) => (
    <li class="post-row">
      {date && <time class="post-date" datetime={isoDate(date)}>{isoDate(date)}</time>}
      <a class="post-title" href={`/snippets/${entry.id}`}>{entry.data.title}</a>
      <p class="post-desc">{entry.data.description}</p>
      {entry.data.type === 'interactive' && (
        <span class="post-tags"><span class="tag">interactive</span></span>
      )}
    </li>
  ))}</ol>
</Base>
<style>
  /* r4/style.css 205-218 */
  .post-row { display: grid; grid-template-columns: 10ch 1fr; gap: 2px 16px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .post-date { font: 12.5px/1.6 var(--mono); color: var(--accent-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .post-title { font-weight: 500; color: var(--text); text-decoration: none; }
  .post-title:hover { color: var(--accent-text); }
  .post-desc { grid-column: -2 / -1; margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.5; }
  .post-tags { grid-column: -2 / -1; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2px; }
  .tag { font: 11.5px var(--mono); color: var(--muted); }
  .tag::before { content: "["; }
  .tag::after { content: "]"; }

  @media (max-width: 560px) {
    .post-row { grid-template-columns: 1fr; gap: 2px; }
    .post-desc, .post-tags { grid-column: 1; }
  }
</style>
