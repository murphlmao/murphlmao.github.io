---
/* Articles index. Markup ported from docs/redesign-previews/r4/articles.html,
   CSS from r4/style.css (.stats) and r4/pages.css (.view-bar, .view, .view__btn,
   .view__hint). The rows exist once, in #flat; scripts/articles.ts moves them into
   #groups for the "by class" view. */
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import CourseGroups from '../../components/CourseGroups.astro';
import { getPosts, getStats, courseCounts } from '../../lib/site';

const posts = await getPosts();
const stats = await getStats();
const counts = await courseCounts();
---
<Base title="Articles" description={`Since ${stats.since} I've written ${stats.total} articles and ${stats.words.toLocaleString()} words.`} scene="articles" wide>
  <header class="page-head">
    <div class="page-head__text">
      <h1>Articles</h1>
      <p class="stats">Since {stats.since} I've written {stats.total} articles and {stats.words.toLocaleString()} words. Please enjoy my strong opinions, feelings, and some of my study material here!</p>
    </div>
    <canvas class="pen" data-scene="articles" aria-hidden="true"></canvas>
  </header>
  <div class="view-bar">
    <div class="view" role="radiogroup" aria-label="Sort articles">
      <button class="view__btn" type="button" role="radio" data-view="date" aria-checked="true">by date</button>
      <button class="view__btn" type="button" role="radio" data-view="class" aria-checked="false">by class</button>
    </div>
    <span class="view__hint">{stats.total} articles</span>
  </div>
  <ol class="post-list is-flat" id="flat">{posts.map((p) => <PostRow post={p} chip />)}</ol>
  <CourseGroups counts={counts} />
</Base>
<style>
  /* r4/style.css 172 */
  .stats { margin: 8px 0 0; max-width: 60ch; color: var(--muted); font-size: 15.5px; line-height: 1.5; }

  /* r4/style.css 204 */
  .post-list { list-style: none; margin: 0; padding: 0; }

  /* r4/pages.css section 2 (aria-pressed -> aria-checked: the switch is a radiogroup) */
  .view-bar { display: flex; align-items: center; gap: 14px; margin: -8px 0 28px; }
  .view { display: inline-flex; padding: 2px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-2); }
  .view__btn { padding: 4px 10px; border-radius: 2px; font: 12.5px/1.4 var(--mono); color: var(--muted); }
  .view__btn:hover { color: var(--text); }
  .view__btn[aria-checked="true"] { color: var(--text); background: color-mix(in srgb, var(--text) 10%, transparent); }
  .view__hint { font: 12.5px var(--mono); color: var(--muted); }

  @media (max-width: 560px) {
    .view-bar { flex-wrap: wrap; }
  }
</style>
