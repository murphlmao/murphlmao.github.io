---
/* Article page (/articles/<post>) and course page (/articles/<category>).
   Markup and CSS ported from docs/redesign-previews/r4/article.html and
   r4/eecs280.html, plus the .article / .article-meta / .article-nav / .crumb /
   .page-sub rules of r4/style.css. */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, getPost, getCategoryPosts, isoDate } from '../../lib/site';
import { getAllCategorySlugs, getCategoryBySlug } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return [
    ...posts.map((p) => ({ params: { slug: p.slug }, props: { kind: 'post' } })),
    ...getAllCategorySlugs().map((slug) => ({ params: { slug }, props: { kind: 'category' } })),
  ];
}
const { slug } = Astro.params;
const { kind } = Astro.props;
const post = kind === 'post' ? await getPost(slug!) : undefined;
const rendered = post ? await render(post.entry) : null;
const Content = rendered?.Content;
const toc = rendered?.headings.filter((h) => h.depth >= 2 && h.depth <= 4) ?? [];

const category = kind === 'category' ? getCategoryBySlug(slug!) : null;
const list = category ? await getCategoryPosts(slug!) : [];
---
{post && Content ? (
  <Base title={post.entry.data.title} description={post.entry.data.description || undefined} scene="article" article toc={toc}>
    <article class="article">
      <header class="page-head"><div class="page-head__text">
        <p class="article-meta"><a href={`/articles/${post.categorySlug}`}>{post.categorySlug}/</a> &middot; <time datetime={isoDate(post.date)}>{isoDate(post.date)}</time> &middot; {post.words.toLocaleString('en-US')} words &middot; about {post.minutes} min read</p>
        <h1>{post.entry.data.title}</h1>
      </div>
      <canvas class="pen" data-scene="article" aria-hidden="true"></canvas></header>
      <Prose><Content /></Prose>
      <nav class="article-nav"><a class="back" href={`/articles/${post.categorySlug}`}>&larr; Back to {post.category.name}</a></nav>
    </article>
  </Base>
) : category ? (
  <Base title={`${category.name} - Articles`} description={category.description} scene="articles" wide>
    <header class="page-head">
      <div class="page-head__text">
        <a class="crumb" href="/articles">&larr; All articles</a>
        <h1>{category.name}</h1>
        <p class="page-sub">{`${slug}/ · ${category.description} · ${list.length} ${list.length === 1 ? 'article' : 'articles'}, oldest first`}</p>
      </div>
    </header>
    {list.length ? (
      <ol class="post-list is-ordered">{list.map((p, i) => <PostRow post={p} n={i + 1} />)}</ol>
    ) : (
      <p class="empty">No posts in this category yet.</p>
    )}
  </Base>
) : (
  <Base title={slug} scene="articles"><h1>{slug}</h1></Base>
)}
<style>
  .article { max-width: var(--w-prose); min-width: 0; }
  .article .page-head { margin-bottom: 28px; }
  .article-meta { margin: 0 0 10px; font: .8em/1.6 var(--mono); color: var(--muted); }
  .page-head__text .article-meta a { color: var(--accent-2); text-decoration: none; }
  .article-meta a:hover { text-decoration: underline; }

  /* course page — r4/style.css 239 */
  .empty { margin: 0; padding: 4px 0 16px; font: 13px var(--mono); color: var(--muted); }

  .article-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--line); font: 13px var(--mono); }
  .article-nav a { display: block; padding: 10px 12px; border: 1px solid var(--line); border-radius: 3px; color: var(--muted); text-decoration: none; }
  .article-nav a:hover { color: var(--text); border-color: var(--accent); }
  .article-nav .next { text-align: right; }
  .article-nav .back { grid-column: 1 / -1; }
  .article-nav small { display: block; margin-bottom: 4px; font-size: 11px; color: var(--muted); }

  @media (max-width: 899px) {
    .article-nav { grid-template-columns: 1fr; }
    .article-nav .next { text-align: left; }
  }
</style>
