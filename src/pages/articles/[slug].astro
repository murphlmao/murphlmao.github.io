---
/* Article page. Markup and CSS ported from docs/redesign-previews/r4/article.html
   and the .article / .article-meta / .article-nav rules of r4/style.css.
   The /articles/<category> branch is filled in by Task 4. */
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import { getPosts, getPost, isoDate } from '../../lib/site';
import { getAllCategorySlugs } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return [
    ...posts.map((p) => ({ params: { slug: p.slug }, props: { kind: 'post' } })),
    ...getAllCategorySlugs().map((slug) => ({ params: { slug }, props: { kind: 'category' } })),
  ];
}
const { slug } = Astro.params;
const { kind } = Astro.props;
const post = kind === 'post' ? await getPost(slug!) : undefined;
const rendered = post ? await render(post.entry) : null;
const Content = rendered?.Content;
const toc = rendered?.headings.filter((h) => h.depth >= 2 && h.depth <= 4) ?? [];
---
{post && Content ? (
  <Base title={post.entry.data.title} description={post.entry.data.description} scene="article" article toc={toc}>
    <article class="article">
      <header class="page-head"><div class="page-head__text">
        <p class="article-meta"><a href={`/articles/${post.categorySlug}`}>{post.categorySlug}/</a> &middot; <time datetime={isoDate(post.date)}>{isoDate(post.date)}</time> &middot; {post.words.toLocaleString()} words &middot; about {post.minutes} min read</p>
        <h1>{post.entry.data.title}</h1>
      </div></header>
      <Prose><Content /></Prose>
      <nav class="article-nav"><a class="back" href={`/articles/${post.categorySlug}`}>&larr; Back to {post.category.name}</a></nav>
    </article>
  </Base>
) : (
  <Base title={slug} scene="articles"><h1>{slug}</h1></Base>
)}
<style>
  .article { max-width: var(--w-prose); min-width: 0; }
  .article .page-head { margin-bottom: 28px; }
  .article-meta { margin: 0 0 10px; font: 13px/1.6 var(--mono); color: var(--muted); }
  .page-head__text .article-meta a { color: var(--accent-2); text-decoration: none; }
  .article-meta a:hover { text-decoration: underline; }

  .article-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--line); font: 13px var(--mono); }
  .article-nav a { display: block; padding: 10px 12px; border: 1px solid var(--line); border-radius: 3px; color: var(--muted); text-decoration: none; }
  .article-nav a:hover { color: var(--text); border-color: var(--accent); }
  .article-nav .next { text-align: right; }
  .article-nav .back { grid-column: 1 / -1; }
  .article-nav small { display: block; margin-bottom: 4px; font-size: 11px; color: var(--muted); }

  @media (max-width: 899px) {
    .article-nav { grid-template-columns: 1fr; }
    .article-nav .next { text-align: left; }
  }
</style>
