---
/* Gear button + native popover. No JS for open/close; the control names match
   the Tweaks keys, src/scripts/tweaks.ts binds to them by name. Row markup and
   labels ported from the details.tweak block in docs/redesign-previews/r4/index.html. */
import { palettes, logos, showTweaks } from '../site.config';
---
{showTweaks && (
<div class="settings">
  <button class="settings__gear side__icon" type="button" popovertarget="tweaks" aria-label="Site settings">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
  </button>
  <form id="tweaks" class="tweak" popover>
    <label class="tweak__row"><span>palette</span><select name="palette">{palettes.map((p) => <option value={p}>{p}</option>)}</select></label>
    <label class="tweak__row"><span>logo</span><select name="logo">{logos.map((l) => <option value={l}>{l}</option>)}</select></label>
    <label class="tweak__row"><span>michigan</span><select name="mich"><option>maize</option><option>accent</option><option>muted</option></select></label>
    <label class="tweak__row"><span>draw</span><select name="draw"><option>pen</option><option>laser</option></select></label>
    <label class="tweak__row"><span>orb spin</span><input type="checkbox" name="orb"></label>
    <label class="tweak__row"><span>background</span><input type="checkbox" name="bg"></label>
    <label class="tweak__row tweak__row--sub"><span>opacity</span><span class="tweak__ctl"><input type="range" name="bgOpacity" min="0" max="100"><output></output></span></label>
    <label class="tweak__row tweak__row--sub"><span>strands</span><input type="checkbox" name="strands"></label>
    <label class="tweak__row tweak__row--sub"><span>particles</span><input type="checkbox" name="motes"></label>
    <label class="tweak__row tweak__row--sub"><span>dim on articles</span><span class="tweak__ctl"><input type="range" name="bgDim" min="0" max="100"><output></output></span></label>
    <label class="tweak__row"><span>paw trail</span><input type="checkbox" name="paws"></label>
    <label class="tweak__row"><span>footer cat</span><input type="checkbox" name="walker"></label>
    <label class="tweak__row"><span>deer</span><input type="checkbox" name="deer"></label>
    <label class="tweak__row"><span>raccoon</span><input type="checkbox" name="raccoon"></label>
    <button class="tweak__reset" type="button">reset</button>
  </form>
</div>
)}
<style>
  /* .tweak* ported from docs/redesign-previews/r4/style.css (the details panel
     became a popover, so the form itself carries the panel chrome). */
  .tweak { font: 12px/1.5 var(--mono); color: var(--muted); }
  .tweak__row { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 8px; min-height: 22px; }
  .tweak__row--sub { padding-left: 12px; }
  .tweak select { font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--line); border-radius: 2px; padding: 2px 4px; max-width: 10ch; cursor: pointer; }
  .tweak select:hover { border-color: var(--muted); }
  .tweak input[type="checkbox"] { width: 14px; height: 14px; margin: 0; accent-color: var(--accent); cursor: pointer; }
  .tweak input[type="range"] { width: 72px; margin: 0; accent-color: var(--accent); }
  .tweak__ctl { display: inline-flex; align-items: center; gap: 6px; }
  .tweak output { min-width: 3ch; text-align: right; color: var(--text); font-variant-numeric: tabular-nums; }
  .tweak__reset { justify-self: start; margin-top: 4px; color: var(--muted); text-decoration: underline; text-underline-offset: .18em; }
  .tweak__reset:hover { color: var(--accent-text); }

  .settings { position: relative; }
  .settings__gear svg { width: 17px; height: 17px; }
  .tweak:popover-open { display: grid; gap: 5px; position: fixed; inset: auto auto 16px 16px; margin: 0; width: 248px; max-height: calc(100vh - 32px); overflow: auto; background: var(--bg-2); border: 1px solid var(--line); border-radius: 8px; padding: 12px; }
  /* below the top bar, top is pinned to 56px instead of bottom to 16px, so the
     max-height inherited from the rule above (100vh - 32px) would run past the
     bottom of short viewports; recompute it from the actual top offset. */
  @media (max-width: 899px) { .tweak:popover-open { inset: 56px 16px auto auto; max-height: calc(100vh - 56px - 16px); } }
</style>
