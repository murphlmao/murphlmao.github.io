---
/* Gear button + native popover. No JS for open/close; the control names match
   the Tweaks keys, src/scripts/tweaks.ts binds to them by name. One markup,
   two presentations (desktop: anchored panel above the gear; mobile: bottom
   sheet), switched purely by media query on `.tweak:popover-open`. Mark tiles
   and Michigan/palette swatches ported from Orb.astro + styles/tokens.css so
   a picked value looks like what it does before you commit to it. */
import { palettes, showTweaks } from '../site.config';
---
{showTweaks && (
<div class="settings">
  <button class="settings__gear side__icon" type="button" popovertarget="tweaks" aria-label="Site settings">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
  </button>
  <form id="tweaks" class="tweak" popover>
    <div class="tweak__hd">
      <span class="tweak__title">Customize</span>
      <button class="tweak__close" type="button" popovertarget="tweaks" popovertargetaction="hide" aria-label="Close settings">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 3l10 10M13 3L3 13"/></svg>
      </button>
    </div>
    <p class="tweak__meta">saved on this device &middot; <button class="tweak__reset" type="button">reset</button></p>

    <div class="tweak__sec">
      <p class="tweak__label">Look</p>

      <div class="tweak__row tweak__row--wide">
        <span class="tweak__rowlabel">Palette</span>
        <div class="chips">
          {palettes.map((p) => (
            <label class="chip">
              <input type="radio" name="palette" value={p} />
              <span class="chip__swatch" style={`--sw-bg:${p === 'space' ? '#000000' : '#121016'};--sw-accent:${p === 'ember' ? '#D7263D' : p === 'alley' ? '#F5A742' : '#FF3B3B'}`}></span>
              {p}
            </label>
          ))}
        </div>
      </div>

      <div class="tweak__row tweak__row--wide">
        <span class="tweak__rowlabel">Mark</span>
        <div class="tiles">
          <label class="tile" title="orb">
            <input type="radio" name="logo" value="orb" />
            <canvas class="orb-preview" width="24" height="24" aria-hidden="true"></canvas>
          </label>
          <label class="tile" title="mark-a">
            <input type="radio" name="logo" value="mark-a" />
            <svg class="tile__mark" viewBox="0 0 32 32" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M4 3l8.6 5.6a12 12 0 0 1 6.8 0L28 3v13c0 7.2-5.4 13-12 13S4 23.2 4 16zM9 17.5a3 3.4 0 1 0 6 0 3 3.4 0 1 0-6 0zM17 17.5a3 3.4 0 1 0 6 0 3 3.4 0 1 0-6 0z"/></svg>
          </label>
          <label class="tile" title="mark-b">
            <input type="radio" name="logo" value="mark-b" />
            <svg class="tile__mark" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M3 29V8l3-6 3.5 4.5L16 16l6.5-9.5L26 2l3 6v21h-6V16l-7 10-7-10v13z"/></svg>
          </label>
          <label class="tile" title="mark-c">
            <input type="radio" name="logo" value="mark-c" />
            <svg class="tile__mark" viewBox="0 0 32 32" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><circle cx="5.5" cy="11" r="2.8"/><circle cx="12" cy="5" r="2.8"/><circle cx="20" cy="5" r="2.8"/><circle cx="26.5" cy="11" r="2.8"/><path d="M4 30V23a7 7 0 0 1 7-7h10a7 7 0 0 1 7 7v7h-6v-6a1.75 1.75 0 0 0-3.5 0v6h-5v-6a1.75 1.75 0 0 0-3.5 0v6z"/></svg>
          </label>
        </div>
      </div>

      <div class="tweak__row tweak__row--wide">
        <span class="tweak__rowlabel">Michigan M</span>
        <div class="chips chips--sm">
          <label class="chip chip--sm"><input type="radio" name="mich" value="maize" /><span class="chip__dot" style="--sw-bg:#FFCB05"></span>maize</label>
          <label class="chip chip--sm"><input type="radio" name="mich" value="accent" /><span class="chip__dot" style="--sw-bg:var(--accent)"></span>accent</label>
          <label class="chip chip--sm"><input type="radio" name="mich" value="muted" /><span class="chip__dot" style="--sw-bg:var(--muted)"></span>muted</label>
        </div>
      </div>
    </div>

    <div class="tweak__sec">
      <p class="tweak__label">Motion</p>

      <div class="tweak__row">
        <span class="tweak__rowlabel">Header drawing</span>
        <div class="seg">
          <label class="seg__opt"><input type="radio" name="draw" value="pen" />pen</label>
          <label class="seg__opt"><input type="radio" name="draw" value="laser" />laser</label>
        </div>
      </div>

      <label class="tweak__row tweak__switchrow"><span class="tweak__rowlabel">Orb spin</span><input type="checkbox" class="switch" name="orb" /></label>
      <label class="tweak__row tweak__switchrow"><span class="tweak__rowlabel">Background</span><input type="checkbox" class="switch" name="bg" /></label>

      <div class="tweak__sub">
        <label class="tweak__row tweak__rangerow"><span class="tweak__rowlabel">Opacity</span><span class="tweak__ctl"><input type="range" name="bgOpacity" min="0" max="100" /><output></output></span></label>
        <label class="tweak__row tweak__switchrow"><span class="tweak__rowlabel">Strands</span><input type="checkbox" class="switch" name="strands" /></label>
        <label class="tweak__row tweak__switchrow"><span class="tweak__rowlabel">Particles</span><input type="checkbox" class="switch" name="motes" /></label>
        <label class="tweak__row tweak__rangerow"><span class="tweak__rowlabel">Dim on articles</span><span class="tweak__ctl"><input type="range" name="bgDim" min="0" max="100" /><output></output></span></label>
      </div>

      <label class="tweak__row tweak__switchrow"><span class="tweak__rowlabel">Paw trail</span><input type="checkbox" class="switch" name="paws" /></label>
    </div>

    <div class="tweak__sec">
      <p class="tweak__label">Critters</p>
      <label class="tweak__row tweak__switchrow"><span class="tweak__rowlabel">Footer cat</span><input type="checkbox" class="switch" name="walker" /></label>
      <label class="tweak__row tweak__switchrow"><span class="tweak__rowlabel">Deer</span><input type="checkbox" class="switch" name="deer" /></label>
      <label class="tweak__row tweak__switchrow"><span class="tweak__rowlabel">Raccoon</span><input type="checkbox" class="switch" name="raccoon" /></label>
    </div>
  </form>
</div>
)}
<style>
  .settings { position: relative; }
  .settings__gear svg { width: 17px; height: 17px; }

  /* ---------------- panel chrome (shared by both presentations) ---------------- */
  .tweak { font: 400 13.5px/1.5 var(--sans); color: var(--text); margin: 0; }
  .tweak:popover-open {
    display: block; box-sizing: border-box;
    background: var(--bg-2); border: 1px solid var(--line); border-radius: 10px;
    box-shadow: 0 0 0 1px rgba(255,255,255,.04), 0 12px 32px rgba(0,0,0,.45);
  }

  .tweak__hd { display: flex; align-items: center; justify-content: space-between; }
  .tweak__title { font: 600 15px/1 var(--sans); color: var(--text); }
  .tweak__close { display: inline-flex; width: 32px; height: 32px; align-items: center; justify-content: center; color: var(--muted); border-radius: var(--radius); }
  .tweak__close:hover, .tweak__close:focus-visible { color: var(--accent-text); background: var(--hover); }
  .tweak__close svg { width: 14px; height: 14px; }

  .tweak__meta { margin: 2px 0 16px; font: 12px var(--mono); color: var(--muted); }
  .tweak__reset { background: none; border: 0; padding: 0; font: inherit; color: var(--muted); text-decoration: underline; text-underline-offset: .18em; cursor: pointer; }
  .tweak__reset:hover { color: var(--accent-text); }

  .tweak__sec { margin-bottom: 18px; }
  .tweak__sec:last-child { margin-bottom: 0; }
  .tweak__label { margin: 0 0 8px; font: 500 11px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }

  .tweak__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 36px; }
  .tweak__row--wide { flex-direction: column; align-items: flex-start; gap: 8px; min-height: auto; padding: 6px 0; }
  .tweak__rowlabel { font: 13.5px var(--sans); color: var(--text); }

  /* sub-group: the two ranges + strands/particles switches, indented with a rule,
     dimmed to inert when Background is off. CSS-only, no JS wiring needed. */
  .tweak__sub { display: flex; flex-direction: column; padding-left: 12px; border-left: 1px solid var(--line); }
  .tweak:has(input[name="bg"]:not(:checked)) .tweak__sub { opacity: .45; pointer-events: none; }

  /* ---------------- controls ---------------- */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px 4px 4px; border: 1px solid transparent; border-radius: 999px; font: 12px var(--mono); color: var(--muted); cursor: pointer; }
  .chip input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .chip:has(input:checked) { border-color: var(--accent); color: var(--text); }
  .chip:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chip__swatch { position: relative; display: inline-block; width: 18px; height: 18px; border-radius: 50%; background: var(--sw-bg); }
  .chip__swatch::after { content: ""; position: absolute; top: 50%; left: 50%; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%; background: var(--sw-accent); }
  .chip--sm { padding: 3px 8px 3px 3px; }
  .chip__dot { display: inline-block; width: 14px; height: 14px; border-radius: 50%; background: var(--sw-bg); }

  .tiles { display: flex; flex-wrap: wrap; gap: 8px; }
  .tile { position: relative; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex: none; background: var(--bg-2); border: 1px solid var(--line); border-radius: 6px; color: var(--accent); cursor: pointer; }
  .tile input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .tile:has(input:checked) { border-color: var(--accent); }
  .tile:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .tile__mark { width: 22px; height: 22px; fill: currentColor; }
  .orb-preview { width: 24px; height: 24px; border-radius: 50%; display: block; }

  .seg { display: inline-flex; height: 28px; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
  .seg__opt { position: relative; display: flex; align-items: center; padding: 0 12px; font: 12.5px var(--mono); color: var(--muted); cursor: pointer; }
  .seg__opt input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .seg__opt:has(input:checked) { background: var(--text); color: var(--bg); }
  .seg__opt:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  .tweak__switchrow input.switch { flex: none; }
  input[type="checkbox"].switch {
    appearance: none; -webkit-appearance: none; margin: 0; width: 34px; height: 20px;
    border-radius: 999px; background: var(--line); position: relative; cursor: pointer;
  }
  input[type="checkbox"].switch::before {
    content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px;
    border-radius: 50%; background: var(--text); transform: translateX(0);
    transition: transform 140ms ease-out;
  }
  input[type="checkbox"].switch:checked { background: var(--accent); }
  input[type="checkbox"].switch:checked::before { transform: translateX(14px); }
  input[type="checkbox"].switch:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .tweak__rangerow input[type="range"] { width: 96px; margin: 0; accent-color: var(--accent); }
  .tweak__ctl { display: inline-flex; align-items: center; gap: 8px; }
  .tweak__ctl output { min-width: 2.5ch; text-align: right; font: 12px var(--mono); color: var(--text); font-variant-numeric: tabular-nums; }

  /* ---------------- desktop: anchored popover above the gear ---------------- */
  @media (min-width: 900px) {
    .tweak:popover-open {
      position: fixed; inset: auto auto 64px 16px; margin: 0;
      width: 300px; max-height: calc(100vh - 96px); overflow: auto;
      padding: 16px; transform-origin: bottom left;
      opacity: 1; transform: translateY(0) scale(1);
      transition: opacity 160ms cubic-bezier(.23,1,.32,1), transform 160ms cubic-bezier(.23,1,.32,1);
    }
    @starting-style {
      .tweak:popover-open { opacity: 0; transform: translateY(6px) scale(.98); }
    }
    .tweak::backdrop { background: transparent; }
  }

  /* ---------------- mobile: bottom sheet ---------------- */
  @media (max-width: 899px) {
    .tweak:popover-open {
      position: fixed; inset: auto 0 0 0; margin: 0;
      width: 100%; max-height: 86vh; overflow: auto;
      border-radius: 16px 16px 0 0;
      padding: 8px 16px calc(16px + env(safe-area-inset-bottom));
      opacity: 1; transform: translateY(0);
      transition: opacity 200ms ease-out, transform 200ms ease-out;
    }
    @starting-style {
      .tweak:popover-open { opacity: 0; transform: translateY(24px); }
    }
    .tweak::before {
      content: ""; display: block; width: 36px; height: 4px; margin: 0 auto 12px;
      border-radius: 999px; background: var(--line);
    }
    .tweak::backdrop { background: rgba(0,0,0,.5); }
  }
</style>
