---
/* Brand mark: the animated orb canvas (src/scripts/orb.ts) or one of the three
   static marks, inlined so they take the accent color and so orb.ts can build
   the favicon from their markup. Which one shows is driven by html[data-logo].
   Ported from docs/redesign-previews/r4/index.html line 16 + style.css:74-82. */
---
<span class="side__mark">
  <canvas id="orb" class="orb" width="40" height="40" aria-hidden="true"></canvas>
  <svg class="mark mark-a" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M4 3l8.6 5.6a12 12 0 0 1 6.8 0L28 3v13c0 7.2-5.4 13-12 13S4 23.2 4 16zM9 17.5a3 3.4 0 1 0 6 0 3 3.4 0 1 0-6 0zM17 17.5a3 3.4 0 1 0 6 0 3 3.4 0 1 0-6 0z"/></svg>
  <svg class="mark mark-b" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M3 29V8l3-6 3.5 4.5L16 16l6.5-9.5L26 2l3 6v21h-6V16l-7 10-7-10v13z"/></svg>
  <svg class="mark mark-c" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><circle cx="5.5" cy="11" r="2.8"/><circle cx="12" cy="5" r="2.8"/><circle cx="20" cy="5" r="2.8"/><circle cx="26.5" cy="11" r="2.8"/><path d="M4 30V23a7 7 0 0 1 7-7h10a7 7 0 0 1 7 7v7h-6v-6a1.75 1.75 0 0 0-3.5 0v6h-5v-6a1.75 1.75 0 0 0-3.5 0v6z"/></svg>
</span>
<style>
  /* ported from docs/redesign-previews/r4/style.css */
  .side__mark { position: relative; display: grid; place-items: center; width: 40px; height: 40px; flex: none; color: var(--accent); }
  .side__mark .orb, .side__mark .mark { display: none; }
  .orb { width: 40px; height: 40px; border-radius: 50%; }
  .mark { width: 32px; height: 32px; fill: currentColor; transition: transform .2s; }
  html[data-logo="orb"] .side__mark .orb,
  html[data-logo="mark-a"] .side__mark .mark-a,
  html[data-logo="mark-b"] .side__mark .mark-b,
  html[data-logo="mark-c"] .side__mark .mark-c { display: block; }
  /* .side__brand lives in Sidebar.astro, so it must escape this component's scope */
  :global(.side__brand):hover .mark { transform: rotate(-8deg); }

  @media (max-width: 899px) {
    .side__mark, .orb { width: 32px; height: 32px; }
    .mark { width: 26px; height: 26px; }
  }
</style>
