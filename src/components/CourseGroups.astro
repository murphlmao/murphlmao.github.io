---
/* #groups — one section per content header, one .course per category.
   Markup ported from docs/redesign-previews/r4/articles.html, CSS from
   r4/style.css (the .group, .course and .empty rules, lines 221-239, 358-359, 378).

   Index-only: the course lists ship EMPTY and the block ships hidden, because the rows
   live once in #flat and scripts/articles.ts moves them in. The section id is the header
   slug and each course id is the category slug, so /articles#<slug> jumps to either
   (articles.ts opens the course it lands on). Courses sort by number, highest first,
   and each is a native <details>: collapsed to its head until clicked.
   Course pages render their own flat .is-ordered list, not this block (R27). */
import { getBlogStructure } from '../lib/content';
import { byCourseNumberDesc } from '../lib/site';

interface Props {
  counts: Record<string, number>;
}
const { counts } = Astro.props;

// public/icons/umich-m.svg is inlined below so --mich can color it; any other header icon
// is rendered as a plain image.
const MICH_ICON = '/icons/umich-m.svg';
const MICH_PATH = 'M396.89,370.68l-56.95-77.86v56.67h22.65v56H257.75v-56H279V262.42H257.75v-56h82.39l56.75,78.43,56.76-78.43H536v56H514.67v87.07H536v56H431.27v-56h22.57V292.82Z';

const headers = getBlogStructure();
---
<div class="groups" id="groups" hidden>
  {headers.map((header) => (
    <section class:list={['group', { 'is-empty': !header.categories.length }]} id={header.slug}>
      <div class="group-head">
        {header.icon === MICH_ICON ? (
          <svg class="group-icon mich-mark" viewBox="0 0 278.28 199" width="36" height="36" fill="currentColor" aria-hidden="true"><path d={MICH_PATH} transform="translate(-257.75 -206.46)" /></svg>
        ) : header.icon && (
          <img class="group-icon" src={header.icon} alt="" width="36" height="36" loading="lazy" decoding="async" />
        )}
        <div>
          <h2 class="group-name">{header.name}</h2>
          <p class="group-desc">{header.description}</p>
        </div>
      </div>
      <div class="group-body">
        {!header.categories.length && <p class="empty">Nothing filed here yet.</p>}
        {byCourseNumberDesc(header.categories).map((category) => {
          const count = counts[category.slug] ?? 0;
          return (
            <details class="course" id={category.slug}>
              <summary class="course-head">
                {category.icon && <img class="course-icon" src={category.icon} alt="" width="44" height="44" loading="lazy" decoding="async" />}
                <p class="course-code">{category.name}</p>
                <p class="course-name">{category.description}</p>
                <p class="course-count">{count} {count === 1 ? 'article' : 'articles'}</p>
                <svg class="course-chev" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3l5 5-5 5"/></svg>
              </summary>
              <div class="course-body">
                <p class="course-link"><a href={`/articles/${category.slug}`}>course page &rarr;</a></p>
                {count === 0 ? (
                  <p class="empty">No posts in this category yet.</p>
                ) : (
                  <ol class="post-list" data-course={category.slug}></ol>
                )}
              </div>
            </details>
          );
        })}
      </div>
    </section>
  ))}
</div>
<style>
  /* r4/style.css 204, 221-239 */
  .group { margin: 0 0 56px; }
  .group-head { position: relative; z-index: 1; display: flex; align-items: center; gap: 14px; width: fit-content; max-width: 100%; margin-bottom: -1px; padding: 12px 18px 12px 14px; background: var(--bg-2); border: 1px solid var(--line); border-bottom: 0; border-radius: var(--radius) var(--radius) 0 0; }
  .group-icon { width: 36px; height: 36px; object-fit: contain; }
  .group-name { margin: 0; font-size: 20px; line-height: 1.3; }
  .group-desc { margin: 0; color: var(--muted); font-size: 14px; }
  .group-body { border-top: 1px solid var(--line); }
  .group.is-empty .group-body { padding: 16px 0 0; }
  /* one collapsible row per course: icon, code + description, count, chevron */
  .course { border-top: 1px solid var(--line); }
  .course:first-child { border-top: 0; }
  .course-head { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto 16px; gap: 3px 14px; align-items: center; padding: 16px 0; list-style: none; cursor: pointer; }
  .course-head::-webkit-details-marker { display: none; }
  .course-head:hover .course-code, .course-head:focus-visible .course-code { color: var(--accent-text); }
  .course-head:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--radius); }
  .course-icon { grid-row: span 2; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: var(--radius); object-fit: cover; }
  .course-code { grid-column: 2; margin: 0; font: 500 15px/1.2 var(--mono); color: var(--text); }
  .course-name { grid-column: 2; margin: 0; color: var(--muted); font-size: 13.5px; line-height: 1.35; }
  .course-count { grid-column: 3; grid-row: span 2; margin: 0; font: 12.5px/1.4 var(--mono); color: var(--accent-text); white-space: nowrap; }
  .course-chev { grid-column: 4; grid-row: span 2; width: 16px; height: 16px; color: var(--muted); transition: transform .18s ease-out; }
  .course[open] .course-chev { transform: rotate(90deg); }
  .course-body { padding: 0 0 16px 58px; }
  .course-link { margin: 0 0 10px; font: 12.5px var(--mono); }
  .course-link a { color: var(--muted); text-decoration: none; }
  .course-link a:hover { color: var(--accent-text); }
  .empty { margin: 0; padding: 4px 0 16px; font: 13px var(--mono); color: var(--muted); }

  @media (max-width: 560px) {
    .course-head { grid-template-columns: 36px minmax(0, 1fr) 16px; }
    .course-icon { width: 36px; height: 36px; }
    .course-count { grid-column: 2; grid-row: auto; }
    .course-chev { grid-column: 3; }
    .course-body { padding-left: 0; }
  }
  @media (max-width: 560px) {
    .group-head { width: 100%; }
  }
</style>
