---
/* Article typography. Ported from the .prose / .code* / .fig* rules of
   docs/redesign-previews/r4/style.css (section 10).
   The styles are global on purpose: <Content /> output is rendered markdown,
   so Astro cannot scope it. The code-block classes are the ones emitted by
   src/lib/rehype-code-wrapper.ts, styled to match r4's .code / .code-head. */
---
<div class="prose"><slot /></div>
<style is:global>
  .prose > p { margin: 0 0 1.2em; }
  .prose h2 { font-size: 1.4em; line-height: 1.25; margin: 44px 0 12px; scroll-margin-top: 24px; }
  .prose h3 { font-size: 1.12em; line-height: 1.3; margin: 32px 0 10px; scroll-margin-top: 24px; }
  .prose h4 { font-size: 1em; line-height: 1.35; margin: 28px 0 8px; scroll-margin-top: 24px; }
  .prose h2::before, .prose h3::before, .prose h4::before { color: var(--accent-text); font-weight: 500; font-family: var(--mono); margin-right: .55em; vertical-align: middle; }
  /* .8em of the page's own scale — each heading's own em is countered so the
     marker reads the same relative size next to h2, h3 and h4 */
  .prose h2::before { content: "##"; font-size: .571em; }
  .prose h3::before { content: "###"; font-size: .714em; }
  .prose h4::before { content: "####"; font-size: .8em; }
  /* long unbroken inline code (e.g. a one-word O(...) expression) breaks instead
     of running off the edge of narrow viewports. */
  .prose code { font: .88em var(--mono); background: color-mix(in srgb, var(--text) 8%, transparent); padding: .1em .35em; border-radius: 2px; overflow-wrap: break-word; }
  .prose pre code { font: inherit; background: none; padding: 0; }
  .prose strong { font-weight: 600; }
  .prose em { font-style: italic; }
  .prose ul, .prose ol { padding-left: 1.4em; margin: 0 0 1.2em; }
  .prose blockquote { margin: 0 0 1.2em; padding-left: 16px; border-left: 2px solid var(--line); color: var(--muted); }
  .prose a { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: .18em; }
  .prose a:hover { color: var(--accent-text); }
  .prose img { max-width: 100%; height: auto; }
  .prose hr { margin: 32px 0; border: 0; border-top: 1px solid var(--line); }
  /* tables are wrapped in .table-scroll by rehype-code-wrapper.ts so a wide table
     (e.g. the binary/hex reference tables) scrolls in its own box instead of
     widening the page on narrow viewports. */
  .table-scroll { margin: 0 0 1.2em; overflow-x: auto; }
  .prose table { width: 100%; margin: 0; border-collapse: collapse; font-size: .88em; }
  .prose th, .prose td { padding: 6px 10px; border: 1px solid var(--line); text-align: left; }
  .prose th { font: 500 .87em var(--mono); color: var(--accent-2); }

  /* code blocks: r4's .code / .code-head / .code-lang on our wrapper markup.
     <pre> keeps shiki's inline background/color, which resolve to the palette
     through the --astro-code-* variables in styles/tokens.css. */
  .code-block-wrapper { position: relative; margin: 24px 0; border: 1px solid var(--line); border-radius: 3px; background: var(--bg-2); overflow: hidden; }
  .code-block-lang { display: block; padding: 5px 12px; border-bottom: 1px solid var(--line); font: .7em var(--mono); color: var(--accent-2); }
  /* astro's shiki `wrap: true` sets white-space: pre-wrap inline; on lines padded
     with long runs of spaces (comment-aligned code), browsers let the trailing
     spaces "hang" past the wrap point, which quietly widens the whole page on
     narrow viewports. break-spaces keeps the same soft-wrap but makes trailing
     spaces take up real (contained) space instead of hanging. !important beats
     the inline style. */
  .code-block-wrapper pre { margin: 0; padding: 14px 16px; overflow: auto; font: .85em/1.6 var(--mono); tab-size: 2; white-space: break-spaces !important; }
  .code-copy { position: absolute; top: 4px; right: 8px; padding: 2px 8px; border: 1px solid transparent; border-radius: 2px; font: .7em var(--mono); color: var(--muted); opacity: 0; transition: opacity .15s; }
  .code-block-wrapper:hover .code-copy, .code-copy:focus-visible { opacity: 1; }
  .code-copy:hover { color: var(--text); border-color: var(--line); }
  .code-block-wrapper.is-copied .code-copy { color: var(--accent-text); opacity: 1; }

  /* framed figure (for hand-written <figure class="fig"> in mdx) */
  .fig { margin: 28px 0; border: 1px solid var(--line); border-radius: 3px; background: var(--bg-2); }
  .fig-head { padding: 5px 12px; border-bottom: 1px solid var(--line); font: .7em var(--mono); color: var(--muted); }
  .fig-body { padding: 12px; }
  .fig-foot { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; justify-content: space-between; padding: 10px 12px; border-top: 1px solid var(--line); }
  @media (max-width: 899px) { .fig-foot { flex-direction: column; align-items: flex-start; } }
</style>
