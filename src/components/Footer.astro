---
/* Ported from the <footer class="foot"> block of docs/redesign-previews/r4/index.html.
   #footWalk is the strip the walking cat (later task) lives on; #critters is the
   canvas the deer/raccoons are drawn on. */
import { site } from '../site.config';

const links = site.nav.filter((item) => item.name !== 'Home');
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="foot__walk" id="footWalk" aria-hidden="true"><canvas class="critters" id="critters" aria-hidden="true"></canvas></div>
  <div class="foot__row">
    <ul class="foot__nav">{links.map((item) => <li><a href={item.href}>{item.name}</a></li>)}</ul>
    <p class="foot__copy">&copy; {year} Murphy Malcolm. All rights reserved.</p>
  </div>
</footer>
<style>
  /* .foot* / .critters ported from docs/redesign-previews/r4/style.css (section 12). */
  .foot { margin-top: 64px; padding-bottom: 32px; font: 12.5px var(--mono); color: var(--muted); }
  .foot__walk { position: relative; height: 56px; overflow: hidden; border-bottom: 1px solid var(--line); }
  .critters { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .foot__row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; padding-top: 20px; }
  .foot__nav { display: flex; gap: 14px; list-style: none; margin: 0; padding: 0; }
  .foot a { color: var(--muted); text-decoration: none; }
  .foot a:hover { color: var(--text); }
  .foot__copy { margin: 0 0 0 auto; }

  @media (max-width: 899px) {
    .foot__copy { margin-left: 0; width: 100%; }
  }
</style>
