---
/* Fixed sidebar. Ported from the <aside class="side"> block of
   docs/redesign-previews/r4/index.html (+ the TOC block of r4/article.html).
   Below 900px it collapses to a 56px bar; `.side__actions` (gear + menu
   button) lives outside `.side__panel` so both stay reachable while the
   sheet is closed. `.side__panel`'s sheet toggle is handled by
   src/scripts/menu.ts, and its backdrop is `.side__backdrop` below it. */
import Orb from './Orb.astro';
import Settings from './Settings.astro';
import { site, showTweaks } from '../site.config';

interface Props {
  toc?: { depth: number; slug: string; text: string }[];
}
const { toc = [] } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));

/* social glyphs, lifted from r4/index.html */
const icons: Record<string, string> = {
