---
<aside class="side">
  <a class="side__brand" href="/"><Orb /><span class="side__domain">{site.domain}</span></a>
  <div class="side__rule"><div class="side-cat" id="sideCat" aria-hidden="true"></div></div>
  <button class="side__menu" type="button" aria-expanded="false" aria-controls="sidepanel">Menu <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"/></svg></button>
  <div class="side__panel" id="sidepanel">
    <p class="side__intro"><span class="side__name">{site.name}</span><span class="side__line">{site.intro}</span></p>
    <nav class="side__nav" aria-label="Site">
      <ul>{site.nav.map((item) => (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.name}</a></li>
      ))}</ul>
    </nav>
    {toc.length > 0 && (
      <nav class="toc" aria-label="On this page">
        <p class="toc__title">On this page</p>
        <ul class="toc__list">{toc.map((h) => (
          <li class={h.depth >= 3 ? 'toc__sub' : undefined}><a class="toc__link" href={`#${h.slug}`}>{h.text}</a></li>
        ))}</ul>
      </nav>
    )}
    <div class="side__spacer"></div>
    <ul class="side__socials">{site.socials.map((s) => (
      <li><a href={s.href} aria-label={s.name} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[s.name]}/></svg></a></li>
    ))}</ul>
    <Settings />
    <p class="side__deer">Tragedy &amp; Pain.<br /><span>7 deer &middot; 8 raccoons &middot; 3 cars</span></p>
  </div>
</aside>
<style>
  /* .side* ported from docs/redesign-previews/r4/style.css (section 5). */
  .side {
    position: sticky; top: 0; align-self: start; height: 100vh; z-index: 3;
    display: flex; flex-direction: column; gap: 20px; padding: 28px 24px 24px;
    background: var(--bg-2); border-right: 1px solid var(--line);
    overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line) transparent;
  }
  .side__panel { display: contents; }
  .side__menu { display: none; }

  /* brand: orb or mark + wordmark */
  .side__brand { display: flex; align-items: center; gap: 12px; width: fit-content; color: var(--text); text-decoration: none; }
  .side__domain { font: 600 20px/1 var(--sans); letter-spacing: -.01em; }

  /* rule that the sidebar cat (later task) sits on */
  .side__rule { position: relative; height: 1px; margin: 6px 0 22px; background: var(--line); }

  /* intro */
  .side__intro { margin: 0; }
  .side__name { display: block; font-size: 17px; font-weight: 600; }
  .side__line { display: block; margin-top: 2px; color: var(--muted); font-size: 13.5px; line-height: 1.45; }

  /* nav with accent dot */
  .side__nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .side__nav a { position: relative; display: block; padding: 5px 0 5px 18px; color: var(--text); text-decoration: none; font-size: 15.5px; font-weight: 500; }
  .side__nav a::before { content: ""; position: absolute; left: 0; top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; background: var(--accent); transform: scale(0); transition: transform .18s ease-out; }
  .side__nav a:hover, .side__nav a[aria-current="page"] { color: var(--accent-text); }
  .side__nav a:hover::before, .side__nav a[aria-current="page"]::before { transform: scale(1); }

  /* TOC (article pages only, under the nav) */
  .toc { border-top: 1px solid var(--line); padding-top: 14px; }
  .toc__title { margin: 0 0 10px; font: 500 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .toc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .toc__link { display: block; padding-left: 10px; border-left: 2px solid transparent; font: 12.5px/1.4 var(--mono); color: var(--muted); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .toc__sub .toc__link { padding-left: 22px; }
  .toc__link:hover { color: var(--text); }
  .toc__link[aria-current="true"] { color: var(--accent-text); border-left-color: var(--accent); }

  .side__spacer { flex: 1; }

  /* socials */
  .side__socials { display: flex; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .side__socials a { display: inline-flex; width: 30px; height: 30px; align-items: center; justify-content: center; color: var(--muted); border-radius: var(--radius); }
  .side__socials a:hover { color: var(--accent-text); background: var(--hover); }
  .side__socials svg { width: 17px; height: 17px; fill: currentColor; }

  /* deer count line (counts become real in a later task) */
  .side__deer { display: block; margin: 0; font: 12px/1.5 var(--mono); color: var(--muted); }
  .side__deer span { display: block; color: var(--accent-text); }

  @media (max-width: 899px) {
    .side { position: sticky; top: 0; height: 56px; align-self: stretch; flex-direction: row; align-items: center; gap: 12px; padding: 0 16px; border-right: 0; border-bottom: 1px solid var(--line); overflow: visible; }
    .side__brand { flex: 1; min-width: 0; gap: 10px; }
    .side__domain { font-size: 17px; }
    .side__rule { order: 1; position: static; height: auto; margin: 0; background: none; }
    .side__menu { order: 2; display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid var(--line); border-radius: var(--radius); font: 500 13px var(--mono); color: var(--text); }
    .side__menu svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
    .side__menu[aria-expanded="true"] { border-color: var(--accent); color: var(--accent-text); }
    .side__panel { display: none; position: fixed; left: 0; right: 0; top: 56px; bottom: 0; z-index: 3; flex-direction: column; gap: 20px; padding: 20px 16px 40px; background: var(--bg-2); overflow-y: auto; }
    .side.is-open .side__panel { display: flex; }
    .side__spacer { display: none; }
  }
</style>
