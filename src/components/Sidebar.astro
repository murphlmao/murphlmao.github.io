/* deer log + gear glyphs, shared by the bottom-cluster pill and (gear only)
   the mobile menu's Customize row -- both trigger the same #tweaks popover. */
const deerPath = 'M12 9.5c-3 0-5.4 2.4-5.4 5.4 0 2.1 1.1 3.6 1.9 4.9.7 1 1.3 1.9 1.3 2.6 0 .7.8 1.1 2.2 1.1s2.2-.4 2.2-1.1c0-.7.6-1.6 1.3-2.6.8-1.3 1.9-2.8 1.9-4.9 0-3-2.4-5.4-5.4-5.4Z M8.6 10.2Q8.1 7.8 5.9 7Q6.6 9.2 8.6 10.2Z M15.4 10.2Q15.9 7.8 18.1 7Q17.4 9.2 15.4 10.2Z M10.6 10.2Q9.2 5 6 1.3Q6.9 6.6 10.6 10.2Z M13.4 10.2Q14.8 5 18 1.3Q17.1 6.6 13.4 10.2Z';
const gearPath = 'M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z';
---
<aside class="side">
  <a class="side__brand" href="/"><Orb /><span class="side__domain">{site.domain}</span></a>
  <div class="side__rule"><div class="side-cat" id="sideCat" aria-hidden="true"></div></div>
  <div class="side__actions">
    <button class="side__menuBtn side__icon" type="button" aria-expanded="false" aria-controls="sidepanel" aria-label="Menu">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </button>
  </div>
  <div class="side__panel" id="sidepanel">
    <div class="side__intro">
      <span class="side__name">{site.name}</span>
      {site.roles.map((r) => (
        <p class="side__role"><span class="side__role-title">{r.title}</span> <span class="side__role-at">@ {r.at}</span></p>
      ))}
    </div>
    <nav class="side__nav" aria-label="Site">
      <ul>{site.nav.map((item) => (
        <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.name}</a></li>
      ))}</ul>
      <a class="side__settingsRow side__deerRow" href="/deer">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d={deerPath}/></svg>
        <span>Deer log</span>
      </a>
      {showTweaks && (
        <button class="side__settingsRow" type="button" popovertarget="tweaks" aria-label="Site settings">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d={gearPath}/></svg>
          <span>Customize</span>
        </button>
      )}
    </nav>
    {toc.length > 0 && (
      <nav class="toc" aria-label="On this page">
        <p class="toc__title">On this page</p>
        <ul class="toc__list">{toc.map((h) => (
          <li class={h.depth >= 3 ? 'toc__sub' : undefined}><a class="toc__link" href={`#${h.slug}`}>{h.text}</a></li>
        ))}</ul>
      </nav>
    )}
    <div class="side__spacer"></div>
    <div class="side__bottom">
      <div class="side__icons">
        {site.socials.map((s) => (
          <a class="side__icon" href={s.href} aria-label={s.name} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[s.name]}/></svg></a>
        ))}
        <span class="side__sep" aria-hidden="true"></span>
        <a class="side__icon side__deer" href="/deer" aria-label="Deer log" title="Deer log"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={deerPath}/></svg></a>
        <Settings />
      </div>
    </div>
  </div>
  <div class="side__backdrop"></div>
</aside>
<style>
  /* .side* ported from docs/redesign-previews/r4/style.css (section 5). */
  .side {
    position: sticky; top: 0; align-self: start; height: 100vh; z-index: 3;
    display: flex; flex-direction: column; gap: 20px; padding: 28px 24px 24px;
    background: var(--bg-2); border-right: 1px solid var(--line);
    overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line) transparent;
  }
  .side__panel { display: contents; }

  /* menu button: a sibling of .side__panel (not inside it) so it stays
     reachable on mobile while the sheet is closed. order:5 keeps it at
     the bottom of the desktop column, after the unrolled panel content
     (the gear lives in the bottom icon row instead, see .side__icons). */
  .side__actions { display: flex; align-items: center; gap: 2px; order: 5; }
  .side__menuBtn { display: none; }
  .side__backdrop { display: none; }

  /* brand: orb or mark + wordmark */
  .side__brand { display: flex; align-items: center; gap: 12px; width: fit-content; color: var(--text); text-decoration: none; }
  .side__domain { font: 600 20px/1 var(--sans); letter-spacing: -.01em; }

  /* rule that the sidebar cat (sidecat.ts) sits on */
  .side__rule { position: relative; height: 1px; margin: 6px 0 22px; background: var(--line); }

  /* intro: name + two role lines (job title, then school), site.roles */
  .side__intro { margin: 0; }
  .side__name { display: block; font-size: 17px; font-weight: 600; margin-bottom: 10px; }
  .side__role { margin: 0; font: 500 13px/1.4 var(--sans); color: var(--text); }
  .side__role + .side__role { margin-top: 6px; }
  .side__role-at { font-weight: 400; color: var(--muted); }

  /* nav with accent dot */
  .side__nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .side__nav a { position: relative; display: block; padding: 5px 0 5px 18px; color: var(--text); text-decoration: none; font-size: 15.5px; font-weight: 500; }
  .side__nav a::before { content: ""; position: absolute; left: 0; top: 50%; width: 6px; height: 6px; margin-top: -3px; border-radius: 50%; background: var(--accent); transform: scale(0); transition: transform .18s ease-out; }
  .side__nav a:hover, .side__nav a[aria-current="page"] { color: var(--accent-text); }
  .side__nav a:hover::before, .side__nav a[aria-current="page"]::before { transform: scale(1); }

  /* Customize row: mobile-only nested settings trigger (menu.ts closes the
     sheet when the #tweaks popover it opens toggles open). Hidden on desktop,
     where the bottom-cluster gear pill (Settings.astro) is the only trigger. */
  /* mobile-only rows; the anchor form needs the extra specificity to beat .side__nav a */
  .side__settingsRow, .side__nav a.side__deerRow { display: none; }

  /* TOC (article pages only, under the nav) */
  .toc { border-top: 1px solid var(--line); padding-top: 14px; }
  .toc__title { margin: 0 0 10px; font: 500 11px/1 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .toc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .toc__link { display: block; padding-left: 10px; border-left: 2px solid transparent; font: 12.5px/1.4 var(--mono); color: var(--muted); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .toc__sub .toc__link { padding-left: 22px; }
  .toc__link:hover { color: var(--text); }
  .toc__link[aria-current="true"] { color: var(--accent-text); border-left-color: var(--accent); }

  .side__spacer { flex: 1; }

  /* bottom cluster: one icon row -- the socials, a hairline, then the deer log
     and the settings gear (Settings.astro, same .side__icon box). Same baseline,
     two groups. */
  .side__icons { display: flex; align-items: center; gap: 2px; }
  .side__icon svg { width: 17px; height: 17px; fill: currentColor; }
  .side__sep { width: 1px; height: 16px; margin: 0 8px; background: var(--line); }

  @media (max-width: 899px) {
    /* three-column bar: brand left, cat centered in the middle column, menu
       button right -- a grid (not flex+flex:1) so the cat sits at the bar's
       true center. The flanks are minmax(0,1fr) rather than bare `auto` so
       they end up equal width (and the middle stays centered) even though
       the brand's content is wider than the lone menu button's. */
    .side { position: sticky; top: 0; height: 56px; align-self: stretch; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 12px; padding: 0 16px; border-right: 0; border-bottom: 1px solid var(--line); overflow: visible; }
    .side__brand { min-width: 0; gap: 10px; justify-self: start; }
    .side__domain { font-size: 17px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .side__rule { position: static; height: auto; margin: 0; background: none; justify-self: center; }
    .side__actions { gap: 4px; justify-self: end; }

    /* icon-only hamburger that morphs to an × via transform/opacity only */
    .side__menuBtn { display: inline-flex; flex-direction: column; justify-content: center; align-items: center; gap: 5px; }
    .side__menuBtn .bar { display: block; width: 18px; height: 2px; border-radius: 1px; background: currentColor; transition: transform 180ms ease-out, opacity 180ms ease-out; }
    .side__menuBtn[aria-expanded="true"] { color: var(--accent-text); }
    .side__menuBtn[aria-expanded="true"] .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .side__menuBtn[aria-expanded="true"] .bar:nth-child(2) { opacity: 0; }
    .side__menuBtn[aria-expanded="true"] .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* sheet: drops from under the 56px bar, not full-screen. Kept in the
       render tree (not display:none) at rest so opacity/transform can
       transition it in; visibility+pointer-events do the actual hiding. */
    .side__panel {
      display: flex; position: fixed; left: 0; right: 0; top: 56px; z-index: 3;
      flex-direction: column; gap: 16px; padding: 8px 16px 20px;
      max-height: calc(100vh - 56px); overflow-y: auto;
      background: var(--bg-2); border-bottom: 1px solid var(--line); border-radius: 0 0 16px 16px;
      visibility: hidden; opacity: 0; pointer-events: none; transform: translateY(-8px);
      transition: opacity 180ms ease-out, transform 180ms ease-out;
    }
    .side.is-open .side__panel { visibility: visible; opacity: 1; pointer-events: auto; transform: translateY(0); }
    .side__intro { display: none; }
    .side__spacer { display: none; }

    /* nav rows: 48px, 17px/500 */
    .side__nav a { min-height: 48px; display: flex; align-items: center; font-size: 17px; }

    /* Customize row: same 48px/17px rhythm as the nav rows above it */
    .side__settingsRow { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 48px; padding: 0; background: none; border: 0; color: var(--text); font: 500 17px/1 var(--sans); text-align: left; cursor: pointer; }
    .side__settingsRow svg { width: 19px; height: 19px; color: var(--muted); flex: none; }
    .side__settingsRow:hover, .side__settingsRow:focus-visible { color: var(--accent-text); }
    .side__deerRow { text-decoration: none; border-top: 1px solid var(--line); margin-top: 6px; padding-top: 6px; }
    .side__deerRow svg { fill: currentColor; stroke: none; }
    /* the menu has its own Deer log / Customize rows; hide only the icons (the gear's
       .settings wrapper stays in the tree so the #tweaks popover can reach the top layer) */
    .side__sep, .side__deer, .side__icons :global(.settings__gear) { display: none; }

    /* TOC rows: 40px */
    /* long headings wrap in the sheet instead of clipping; block keeps the row a full-width tap target */
    .toc__link { display: block; min-height: 40px; padding-top: 10px; padding-bottom: 10px; white-space: normal; line-height: 1.4; }

    /* bottom cluster: hairline above it (nav/TOC already carry their own separators) */
    .side__bottom { border-top: 1px solid var(--line); padding-top: 14px; margin-top: 2px; }

    /* backdrop below the sheet, click closes (menu.ts) */
    .side__backdrop {
      display: block; position: fixed; inset: 56px 0 0 0; z-index: 2;
      background: rgba(0,0,0,.5); opacity: 0; pointer-events: none;
      transition: opacity 150ms ease-out;
    }
    .side.is-open .side__backdrop { opacity: 1; pointer-events: auto; }
  }
</style>
