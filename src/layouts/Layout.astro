---
/* Legacy layout: a thin wrapper around Base so the pre-v2 pages keep rendering
   (inside the new shell) until each one is ported. */
import Base from './Base.astro';
import '../styles/globals.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
}

const { title, description, article } = Astro.props;
---
<Base title={title} description={description} article={!!article}>
  <slot name="head" slot="head" />
  <slot />
</Base>
